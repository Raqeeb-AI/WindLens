{
  "openapi": "3.1.0",
  "info": {
    "title": "WindLens API",
    "description": "Cutoff-aware UK national wind generation forecast intelligence API. Evaluates day-ahead procurement decisions in January 2026 using authoritative Elexon FUELHH and WINDFOR data.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Get Health",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/metadata": {
      "get": {
        "tags": [
          "Metadata"
        ],
        "summary": "Get Metadata",
        "operationId": "get_metadata_api_v1_metadata_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppMetadataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/decision": {
      "get": {
        "tags": [
          "Decision Day"
        ],
        "summary": "Get Decision Analysis",
        "operationId": "get_decision_analysis_api_v1_decision_get",
        "parameters": [
          {
            "name": "decision_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Decision date in YYYY-MM-DD format (within Jan 2026)",
              "default": "2026-01-15",
              "title": "Decision Date"
            },
            "description": "Decision date in YYYY-MM-DD format (within Jan 2026)"
          },
          {
            "name": "cutoff_time",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$",
              "description": "Procurement decision cutoff time in HH:MM format",
              "default": "09:00",
              "title": "Cutoff Time"
            },
            "description": "Procurement decision cutoff time in HH:MM format"
          },
          {
            "name": "cutoff_timezone",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Timezone context for the cutoff time",
              "default": "Europe/London",
              "title": "Cutoff Timezone"
            },
            "description": "Timezone context for the cutoff time"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accuracy": {
      "get": {
        "tags": [
          "Accuracy"
        ],
        "summary": "Get Accuracy Analysis",
        "operationId": "get_accuracy_analysis_api_v1_accuracy_get",
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Start decision date in YYYY-MM-DD format",
              "default": "2026-01-01",
              "title": "Start Date"
            },
            "description": "Start decision date in YYYY-MM-DD format"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "End decision date in YYYY-MM-DD format",
              "default": "2026-01-31",
              "title": "End Date"
            },
            "description": "End decision date in YYYY-MM-DD format"
          },
          {
            "name": "cutoff_time",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$",
              "description": "Procurement decision cutoff time in HH:MM format",
              "default": "09:00",
              "title": "Cutoff Time"
            },
            "description": "Procurement decision cutoff time in HH:MM format"
          },
          {
            "name": "cutoff_timezone",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Timezone context for cutoff",
              "default": "Europe/London",
              "title": "Cutoff Timezone"
            },
            "description": "Timezone context for cutoff"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccuracyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
